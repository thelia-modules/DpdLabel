{# Configuration fragment — no {% extends %} — rendered inside the module-configure page #}
{% form_theme form with bo_form_themes only %}

<div class="card mb-4" id="dpdlabel-config">
    <div class="card-header">
        {{ 'Configure DpdLabel'|trans({}, 'dpdlabel.bo.default') }}
    </div>
    <div class="card-body">

        {{ form_start(form, {action: path('dpdlabel_api_config'), method: 'POST', attr: {id: 'dpdlabel-config-form'}}) }}

        {% if form.vars.errors|length %}
            <div class="alert alert-danger">
                {% for error in form.vars.errors %}{{ error.message }}{% endfor %}
            </div>
        {% endif %}

        <div class="row">
            <div class="col-md-6">
                {% if codes|length %}
                    {% for code in codes %}
                        <fieldset class="border rounded p-3 mb-3">
                            <legend class="h6 float-none w-auto px-2">{{ code }}</legend>
                            {{ form_row(attribute(form, 'user_id_' ~ code)) }}
                            {{ form_row(attribute(form, 'password_' ~ code)) }}
                            {{ form_row(attribute(form, 'center_number_' ~ code)) }}
                            {{ form_row(attribute(form, 'customer_number_' ~ code)) }}
                        </fieldset>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-danger">
                        {{ 'No DPD delivery module was found. Please install at least one DPD delivery module.'|trans({}, 'dpdlabel.bo.default') }}
                    </div>
                {% endif %}

                {{ form_row(form.label_type) }}
                {{ form_row(form.isTest) }}
            </div>

            <div class="col-md-6">
                {{ form_row(form.shipper_name) }}
                {{ form_row(form.shipper_address1) }}
                {{ form_row(form.shipper_country) }}
                {{ form_row(form.shipper_city) }}
                {{ form_row(form.shipper_zip_code) }}
                {{ form_row(form.shipper_phone) }}
                {{ form_row(form.shipper_fax) }}
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" name="save_mode" value="stay" class="btn btn-primary btn-sm">
                <i class="bi bi-save"></i> {{ 'Save changes'|trans({}, 'dpdlabel.bo.default') }}
            </button>
            <button type="submit" name="save_mode" value="close" class="btn btn-outline-primary btn-sm">
                {{ 'Save changes'|trans({}, 'dpdlabel.bo.default') }} &amp; {{ 'Cancel'|trans({}, 'dpdlabel.bo.default') }}
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
