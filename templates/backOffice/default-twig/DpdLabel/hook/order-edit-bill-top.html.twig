{# Order edit "Billing" tab fragment — no {% extends %} #}
{% form_theme form with bo_form_themes only %}

<div class="card mb-3" id="dpdlabel-order-label">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>{{ 'DPD label'|trans({}, 'dpdlabel.bo.default') }}</span>
        <span>
            <button type="button" class="btn btn-primary btn-sm js-dpd-order-generate" data-retour="1"
                    data-bs-toggle="modal" data-bs-target="#dpdlabel-order-label-dialog">
                <i class="bi bi-arrow-return-left"></i> {{ 'Generate retour Label'|trans({}, 'dpdlabel.bo.default') }}
            </button>
            {% if not label_number %}
                <button type="button" class="btn btn-success btn-sm js-dpd-order-generate" data-retour="0"
                        data-bs-toggle="modal" data-bs-target="#dpdlabel-order-label-dialog">
                    <i class="bi bi-upc-scan"></i> {{ 'Generate a label'|trans({}, 'dpdlabel.bo.default') }}
                </button>
            {% endif %}
        </span>
    </div>
    <div class="card-body">
        {% if err %}
            <div class="alert alert-danger">{{ err }}</div>
        {% endif %}

        {% if label_number %}
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'Label Number'|trans({}, 'dpdlabel.bo.default') }}</th>
                            <th>{{ 'Format'|trans({}, 'dpdlabel.bo.default') }}</th>
                            <th>{{ 'Weight'|trans({}, 'dpdlabel.bo.default') }}</th>
                            <th>{{ 'Date'|trans({}, 'dpdlabel.bo.default') }}</th>
                            <th>{{ 'Tracking URL'|trans({}, 'dpdlabel.bo.default') }}</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>{{ label_number }}</td>
                            <td>{{ label_type }}</td>
                            <td>{{ weight }} kg</td>
                            <td>{{ label_created_at ? label_created_at|date('d/m/Y H:i') : '-' }}</td>
                            <td><a target="_dpd" href="https://trace.dpd.fr/fr/trace/{{ label_number }}">https://trace.dpd.fr/fr/trace/{{ label_number }}</a></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-primary btn-sm" href="{{ path('dpdlabel_save_label', {orderId: order_id}) }}">
                                    <i class="bi bi-download"></i> {{ 'Download'|trans({}, 'dpdlabel.bo.default') }}
                                </a>
                                <a class="btn btn-info btn-sm" target="_blank" href="{{ path('dpdlabel_get_label', {orderRef: order_ref}) }}">
                                    <i class="bi bi-eye"></i> {{ 'View'|trans({}, 'dpdlabel.bo.default') }}
                                </a>
                                <a class="btn btn-danger btn-sm"
                                   href="{{ path('dpdlabel_delete_label', {orderId: order_id, redirect_url: path('admin.order.update.view', {order_id: order_id, tab: 'bill'}), _token: token}) }}">
                                    <i class="bi bi-trash"></i> {{ 'Delete'|trans({}, 'dpdlabel.bo.default') }}
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>

{# Generate label modal (normal / retour) #}
<div class="modal fade" id="dpdlabel-order-label-dialog" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            {{ form_start(form, {action: path('dpdlabel_generate_label'), method: 'POST', attr: {id: 'dpdlabel-order-label-form'}}) }}
            <div class="modal-header">
                <h5 class="modal-title">{{ 'Dpd Labels'|trans({}, 'dpdlabel.bo.default') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{ form_row(form.weight) }}
                {{ form_row(form.new_status) }}
                <input type="hidden" name="return_url" value="{{ path('admin.order.update.view', {order_id: order_id, tab: 'bill'}) }}">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans({}, 'dpdlabel.bo.default') }}</button>
                <button type="submit" class="btn btn-primary">{{ 'Create'|trans({}, 'dpdlabel.bo.default') }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';
        var form = document.getElementById('dpdlabel-order-label-form');
        if (!form) return;
        var baseAction = form.getAttribute('action');
        var orderId = {{ order_id }};

        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.js-dpd-order-generate');
            if (!btn) return;
            form.setAttribute('action', baseAction + '?orderId=' + orderId + '&retour=' + (btn.dataset.retour || '0'));
        });
    }());
</script>
